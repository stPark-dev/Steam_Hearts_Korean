 "entries": [
  {
   "id": "st3.001",
   "audio": 0,
   "start": 1.82,
   "end": 4.2,
   "ja": "これが…初めて見るわ",
   "ko": "이게… 처음 봐.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.002",
   "audio": 0,
   "start": 4.88,
   "end": 7.14,
   "ja": "ここがファクトリーの中なのね",
   "ko": "여기가 팩토리 안이구나.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.003",
   "audio": 0,
   "start": 8.0,
   "end": 9.34,
   "ja": "なんか息苦しいな",
   "ko": "왠지 숨이 막히네.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.004",
   "audio": 0,
   "start": 10.32,
   "end": 11.52,
   "ja": "緑の匂いがしない",
   "ko": "풀 냄새가 안 나.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.005",
   "audio": 0,
   "start": 11.52,
   "end": 13.18,
   "ja": "なに言ってんの",
   "ko": "무슨 소리야.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.006",
   "audio": 0,
   "start": 13.64,
   "end": 16.24,
   "ja": "私たちもここで生まれたんでしょ",
   "ko": "우리도 여기서 태어났잖아.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.007",
   "audio": 0,
   "start": 17.48,
   "end": 18.16,
   "ja": "深い",
   "ko": "깊다…",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.008",
   "audio": 0,
   "start": 19.22,
   "end": 21.38,
   "ja": "吸い込まれて落ちてしまいそうだ",
   "ko": "빨려 들어가 떨어질 것 같아.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.009",
   "audio": 0,
   "start": 21.88,
   "end": 25.72,
   "ja": "障害物が多いから、ぶつかったら洒落にならないわよ",
   "ko": "장애물이 많으니까 부딪히면 큰일 나.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.010",
   "audio": 1,
   "start": 1.62,
   "end": 3.32,
   "ja": "あんたたちがアウトロー?",
   "ko": "너희가 무법자야?",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.011",
   "audio": 1,
   "start": 3.76,
   "end": 7.54,
   "ja": "あたしの大事なファクトリーでずいぶん暴れてくれたわね",
   "ko": "내 소중한 팩토리에서 꽤나 날뛰어 줬더라.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.012",
   "audio": 1,
   "start": 8.58,
   "end": 9.3,
   "ja": "あ、あの",
   "ko": "저, 저기…",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.013",
   "audio": 1,
   "start": 9.3,
   "end": 16.4,
   "ja": "この最も美しくて強いタルテキサヌス・イア様がじきじきに遊んであげるわ",
   "ko": "가장 아름답고 강한 타르테키사누스 이아 님이 직접 놀아 주지.",
   "status": "needs_human_review",
   "asr_uncertain": true,
   "note": "「イア様」 앞의 칭호 「タルテキサヌス」는 받아쓰기로만 알아 소리대로 옮김. 확인 필요."
  },
  {
   "id": "st3.014",
   "audio": 1,
   "start": 16.4,
   "end": 18.1,
   "ja": "いらっしゃい、坊や",
   "ko": "덤벼 봐, 꼬마야.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.015",
   "audio": 1,
   "start": 19.04,
   "end": 20.44,
   "ja": "う、美しい?",
   "ko": "아름답다고?",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.015n",
   "audio": 1,
   "start": 24.8,
   "end": 27.1,
   "ja": "あはははは、おかしい!",
   "ko": "아하하하, 웃겨!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.016",
   "audio": 1,
   "start": 28.59,
   "end": 30.27,
   "ja": "なーにがおかしいっての?",
   "ko": "뭐가 웃기다는 거야?",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.017",
   "audio": 1,
   "start": 30.59,
   "end": 31.81,
   "ja": "このメスガキ",
   "ko": "이 계집애가.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.018",
   "audio": 1,
   "start": 32.65,
   "end": 34.29,
   "ja": "メスガキですって?",
   "ko": "계집애라고?",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.019",
   "audio": 1,
   "start": 35.89,
   "end": 36.71,
   "ja": "ブロー!",
   "ko": "블로!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.020",
   "audio": 2,
   "start": 0.14,
   "end": 2.92,
   "ja": "もう終わり?",
   "ko": "벌써 끝이야?",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.021",
   "audio": 2,
   "start": 3.34,
   "end": 4.8,
   "ja": "あっけないわね",
   "ko": "싱겁네.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.022",
   "audio": 2,
   "start": 5.36,
   "end": 11.1,
   "ja": "あんたたち消去してあげるわ",
   "ko": "너희를 지워 주겠어.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.023",
   "audio": 3,
   "start": 2.46,
   "end": 3.7,
   "ja": "待ちなさいよ",
   "ko": "기다려!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.024",
   "audio": 3,
   "start": 5.82,
   "end": 8.08,
   "ja": "こいつはすごいわよ",
   "ko": "이건 굉장할걸.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.025",
   "audio": 3,
   "start": 10.92,
   "end": 13.28,
   "ja": "ブラックホールボムか、まずい",
   "ko": "블랙홀 폭탄인가. 큰일이다.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.026",
   "audio": 3,
   "start": 17.61,
   "end": 19.05,
   "ja": "オーバーブーストだ、ファラ",
   "ko": "오버부스트야, 파라!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.027",
   "audio": 3,
   "start": 21.51,
   "end": 23.31,
   "ja": "喋るな、舌を噛む",
   "ko": "말하지 마, 혀 깨문다.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.028",
   "audio": 3,
   "start": 24.21,
   "end": 27.43,
   "ja": "行っちゃいなさい、静寂の彼方へ",
   "ko": "가 버려라, 정적의 저편으로!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.029",
   "audio": 4,
   "start": 3.84,
   "end": 6.22,
   "ja": "鬼ごっこはおしまいだね、イア",
   "ko": "술래잡기는 끝이야, 이아.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.031",
   "audio": 4,
   "start": 7.22,
   "end": 10.58,
   "ja": "ふぅ、やっと終わったわね",
   "ko": "휴, 겨우 끝났네.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.032",
   "audio": 4,
   "start": 10.86,
   "end": 11.3,
   "ja": "うん",
   "ko": "응.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.033",
   "audio": 4,
   "start": 11.88,
   "end": 14.98,
   "ja": "さて、大人の遊びを",
   "ko": "자, 그럼 어른의 놀이를…",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.034",
   "audio": 4,
   "start": 14.98,
   "end": 15.74,
   "ja": "おいおい",
   "ko": "어이어이.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.035",
   "audio": 4,
   "start": 15.74,
   "end": 18.26,
   "ja": "じゃなくて治療だったわね",
   "ko": "가 아니라 치료였지.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.036",
   "audio": 4,
   "start": 18.52,
   "end": 22.97,
   "ja": "あら、この子気絶してるわ",
   "ko": "어머, 얘 기절했어.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.037",
   "audio": 5,
   "start": 1.74,
   "end": 5.76,
   "ja": "この私に挑もうなんて10年早いわ、坊や",
   "ko": "나한테 덤비기엔 10년은 이르다, 꼬마야.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.038",
   "audio": 5,
   "start": 6.4,
   "end": 7.34,
   "ja": "死ねない!",
   "ko": "죽을 수 없어!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.039",
   "audio": 5,
   "start": 7.88,
   "end": 9.64,
   "ja": "僕たちの代わりはいないんだ!",
   "ko": "우리 대신은 없어!",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.040",
   "audio": 6,
   "start": 1.66,
   "end": 2.1,
   "ja": "どう?",
   "ko": "어때?",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.041",
   "audio": 6,
   "start": 3.12,
   "end": 6.34,
   "ja": "これに懲りたらもう変な気起こさないことね",
   "ko": "이번에 혼났으면 다시는 이상한 생각 하지 마.",
   "status": "distribution_eligible"
  },
  {
   "id": "st3.042",
   "audio": 6,
   "start": 6.9,
   "end": 10.18,
   "ja": "あんたなんかに負けるなんて認めないわ",
   "ko": "너 같은 것한테 지다니 인정 못 해.",
   "status": "distribution_eligible"
  }
 ]
}
