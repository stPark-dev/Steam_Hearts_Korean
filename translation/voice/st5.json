  },
  {
   "id": "st5.013",
   "audio": 0,
   "start": 61.15,
   "end": 66.77,
   "ja": "ブロー、私を置いて死んだら許さないから",
   "ko": "블로, 날 두고 죽으면 용서 안 할 거야.",
   "status": "needs_review"
