  },
  {
   "id": "st8.002",
   "audio": 0,
   "start": 2.08,
   "end": 2.4,
   "ja": "大丈夫",
   "ko": "괜찮아.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.003",
   "audio": 0,
   "start": 3.42,
   "end": 4.94,
   "ja": "船が崩れる?",
   "ko": "배가 무너지는 거야?",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.004",
   "audio": 0,
   "start": 5.86,
   "end": 6.8,
   "ja": "急げ、ファラ!",
   "ko": "서둘러, 파라!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.005",
   "audio": 0,
   "start": 11.61,
   "end": 12.65,
   "ja": "まだ動いている",
   "ko": "아직 움직이고 있어.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.006",
   "audio": 0,
   "start": 12.65,
   "end": 13.39,
   "ja": "どうして?",
   "ko": "어째서?",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.007",
   "audio": 0,
   "start": 13.93,
   "end": 15.89,
   "ja": "プロトはこっちに乗っているのに",
   "ko": "프로토는 여기 타고 있는데.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.008",
   "audio": 0,
   "start": 15.89,
   "end": 19.09,
   "ja": "ウイルス自身が僕たちを殺すっていうのか",
   "ko": "바이러스 스스로 우리를 죽이려는 거야?",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.008n1",
   "audio": 0,
   "start": 23.22,
   "end": 24.38,
   "ja": "持ちこたえて!",
   "ko": "버텨 줘!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.008n2",
   "audio": 0,
   "start": 24.64,
   "end": 25.86,
   "ja": "ファラ、逃げろ!",
   "ko": "파라, 도망쳐!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.008n3",
   "audio": 0,
   "start": 27.94,
   "end": 28.86,
   "ja": "ファラ!",
   "ko": "파라!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.008n4",
   "audio": 0,
   "start": 35.2,
   "end": 37.0,
   "ja": "何をグズグズしている!",
   "ko": "뭘 꾸물거리고 있나!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.009",
   "audio": 0,
   "start": 37.54,
   "end": 38.28,
   "ja": "アルバルト!",
   "ko": "알바르트!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.010",
   "audio": 0,
   "start": 39.06,
   "end": 41.7,
   "ja": "あまりに遅いんで、しびれを切らしたぞ",
   "ko": "너무 늦어서 기다리다 지쳤다.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.011",
   "audio": 0,
   "start": 42.28,
   "end": 43.12,
   "ja": "恩に着るよ",
   "ko": "고마워.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.012",
   "audio": 0,
   "start": 43.54,
   "end": 45.22,
   "ja": "ファラ、行けるか?",
   "ko": "파라, 갈 수 있겠어?",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.013",
   "audio": 0,
   "start": 45.92,
   "end": 48.06,
   "ja": "どうにか、持ちそうよ",
   "ko": "어떻게든 버틸 것 같아.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.014",
   "audio": 0,
   "start": 48.56,
   "end": 49.46,
   "ja": "早くしろ!",
   "ko": "서둘러라!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.015",
   "audio": 0,
   "start": 49.46,
   "end": 52.22,
   "ja": "私とていつまで持つかわからん",
   "ko": "나도 언제까지 버틸지 모른다.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.016",
   "audio": 0,
   "start": 52.72,
   "end": 54.08,
   "ja": "君も一緒に",
   "ko": "너도 같이…",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.017",
   "audio": 0,
   "start": 54.08,
   "end": 54.84,
   "ja": "先に行け",
   "ko": "먼저 가라.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.018",
   "audio": 0,
   "start": 55.38,
   "end": 57.5,
   "ja": "こいつはまだ生きている",
   "ko": "이 녀석은 아직 살아 있다.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.019",
   "audio": 0,
   "start": 57.5,
   "end": 58.18,
   "ja": "でも",
   "ko": "하지만…",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.020",
   "audio": 0,
   "start": 58.18,
   "end": 60.2,
   "ja": "どうした、早くしろ",
   "ko": "왜 그러지? 서둘러라!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.021",
   "audio": 0,
   "start": 60.2,
   "end": 63.38,
   "ja": "お前たちが今までしてきたことを無駄にするつもりか",
   "ko": "너희가 지금까지 해 온 일을 헛되게 할 셈이냐?",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.022",
   "audio": 0,
   "start": 65.35,
   "end": 67.01,
   "ja": "プロトを助けるのが先だ",
   "ko": "프로토를 구하는 게 먼저야.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.023",
   "audio": 0,
   "start": 70.0,
   "end": 72.94,
   "ja": "アルバルトの好意を無駄にしたくないんだ",
   "ko": "알바르트의 호의를 헛되게 하고 싶지 않아.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.024",
   "audio": 0,
   "start": 72.94,
   "end": 75.5,
   "ja": "いい奴らだよ",
   "ko": "좋은 녀석들이야.",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.025",
   "audio": 0,
   "start": 79.85,
   "end": 85.48,
   "ja": "アウトローともっと早くに出会えていたらな",
   "ko": "무법자들과 좀 더 일찍 만났더라면…",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.025n",
   "audio": 0,
   "start": 88.58,
   "end": 89.46,
   "ja": "アルバルト!",
   "ko": "알바르트!",
   "status": "distribution_eligible"
  },
  {
   "id": "st8.026",
   "audio": 0,
   "start": 90.56,
   "end": 93.82,
