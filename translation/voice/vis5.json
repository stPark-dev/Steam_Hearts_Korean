{
 "scene": 5,
 "ja_source": "faster-whisper large-v3·kotoba-whisper v2.0 대조, AI 교정(2026-10-07); AI 교차 검수(2026-10-07)",
 "note": "start/end는 음성 파일 시작부터의 초. audio는 장면 안에서 재생되는 순서(0부터). 게임에서는 그 음성이 실제로 울리기 시작한 순간(사운드 칩 슬롯 12 키온)부터 잰다.",
 "audio": [
  {
   "file": "VIS5A.AIF"
  },
  {
   "file": "VIS5B.AIF"
  },
  {
   "file": "VIS5C.AIF"
  }
 ],
 "entries": [
  {
   "id": "vis5.001",
   "audio": 0,
   "start": 2.26,
   "end": 3.42,
   "ja": "あなたたちは誰?",
   "ko": "당신들은 누구야?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.002",
   "audio": 0,
   "start": 4.48,
   "end": 5.48,
   "ja": "私はファラ",
   "ko": "난 파라.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.003",
   "audio": 0,
   "start": 6.12,
   "end": 7.06,
   "ja": "僕はブロー",
   "ko": "난 블로.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.004",
   "audio": 0,
   "start": 7.9,
   "end": 8.44,
   "ja": "君は?",
   "ko": "넌?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.005",
   "audio": 0,
   "start": 9.16,
   "end": 11.6,
   "ja": "このエリアの守護者、レイファン",
   "ko": "이 지역의 수호자, 레이판.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.006",
   "audio": 0,
   "start": 12.1,
   "end": 13.24,
   "ja": "君のことなんだね",
   "ko": "너였구나.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.007",
   "audio": 0,
   "start": 13.84,
   "end": 16.3,
   "ja": "夢を見ながら街に至るというのは",
   "ko": "'꿈을 꾸며 거리에 이른다'는 게.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.008",
   "audio": 0,
   "start": 17.18,
   "end": 18.56,
   "ja": "どうしてここへ来たの?",
   "ko": "왜 여기 왔어?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.009",
   "audio": 0,
   "start": 19.48,
   "end": 21.94,
   "ja": "僕の使命を果たすために",
   "ko": "내 사명을 다하기 위해.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.010",
   "audio": 0,
   "start": 22.64,
   "end": 25.96,
   "ja": "私にもみんなのようにエッチなことするの?",
   "ko": "나한테도 다른 애들처럼 야한 짓 할 거야?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.011",
   "audio": 0,
   "start": 26.24,
   "end": 27.38,
   "ja": "レイファン、",
   "ko": "레이판,",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.012",
   "audio": 0,
   "start": 27.44,
   "end": 30.7,
   "ja": "僕たちのことでどういう情報が伝わってるんだい?",
   "ko": "우리에 대해 어떤 소문이 돈 거야?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.013",
   "audio": 0,
   "start": 31.12,
   "end": 32.98,
   "ja": "そんなこと言えない",
   "ko": "그런 건 말 못 해.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.014",
   "audio": 0,
   "start": 34.08,
   "end": 36.02,
   "ja": "見当違いもいいところだわ",
   "ko": "완전히 헛짚었네.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.015",
   "audio": 0,
   "start": 36.02,
   "end": 36.56,
   "ja": "え?",
   "ko": "어?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.016",
   "audio": 0,
   "start": 37.06,
   "end": 39.26,
   "ja": "あんたたちがどう思ってるか知らないけど",
   "ko": "너희가 어떻게 생각하는지 모르겠지만",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.017",
   "audio": 0,
   "start": 39.7,
   "end": 41.46,
   "ja": "こいつの頭の中にはさ",
   "ko": "이 녀석 머릿속엔 말이야",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.018",
   "audio": 0,
   "start": 42.16,
   "end": 45.46,
   "ja": "みんなを救いたいって、ただそれしかないのよ",
   "ko": "모두를 구하고 싶다는 생각밖에 없어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.018n",
   "audio": 0,
   "start": 46.02,
   "end": 49.42,
   "ja": "あら、信じられない",
   "ko": "어머, 믿을 수 없어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.019",
   "audio": 0,
   "start": 50.16,
   "end": 53.26,
   "ja": "自分で自分のやりたいと思ったことをする",
   "ko": "스스로 하고 싶다고 생각한 일을 해.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.020",
   "audio": 0,
   "start": 53.92,
   "end": 56.84,
   "ja": "他のみんなからはアウトロー扱いされても",
   "ko": "다른 이들에게 무법자 취급을 받아도",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.021",
   "audio": 0,
   "start": 56.84,
   "end": 59.58,
   "ja": "あたしたちは自分を信じているわ",
   "ko": "우린 자신을 믿어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.022",
   "audio": 0,
   "start": 60.86,
   "end": 62.4,
   "ja": "服を脱がせているのも",
   "ko": "옷을 벗기는 것도",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.023",
   "audio": 0,
   "start": 62.4,
   "end": 66.3,
   "ja": "ウイルスに侵されたみんなを治療するためにやっていることなの",
   "ko": "바이러스에 감염된 모두를 치료하기 위해서야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.024",
   "audio": 0,
   "start": 66.3,
   "end": 69.5,
   "ja": "平和だった頃のこの星を取り戻したいんだ",
   "ko": "평화롭던 시절의 이 별을 되찾고 싶어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.025",
   "audio": 0,
   "start": 71.87,
   "end": 73.87,
   "ja": "自分が自分らしく生きれる…",
   "ko": "자신이 자신답게 살 수 있는…",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.026",
   "audio": 0,
   "start": 79.04,
   "end": 81.18,
   "ja": "レイファン、嫌なのはわかってる",
   "ko": "레이판, 싫은 건 알아.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.027",
   "audio": 0,
   "start": 81.18,
   "end": 84.36,
   "ja": "でも、僕たちを信じてほしい",
   "ko": "하지만 우릴 믿어 줬으면 해.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.028",
   "audio": 0,
   "start": 85.82,
   "end": 88.71,
   "ja": "君たちを治せるのは僕たちしかいないんだ",
   "ko": "너희를 치료할 수 있는 건 우리밖에 없어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.029",
   "audio": 0,
   "start": 89.69,
   "end": 91.31,
   "ja": "あなたたちみたいな人…",
   "ko": "당신들 같은 사람…",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.030",
   "audio": 0,
   "start": 94.33,
   "end": 95.17,
   "ja": "レイファン",
   "ko": "레이판.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.030n",
   "audio": 0,
   "start": 96.2,
   "end": 97.78,
   "ja": "難しい…",
   "ko": "어려워…",
   "status": "needs_human_review",
   "asr_uncertain": true,
   "note": "두 모델 모두 「難しい」로 들었으나 누구 말인지, 앞부분이 잘린 다른 말인지 불확실함."
  },
  {
   "id": "vis5.031",
   "audio": 0,
   "start": 97.78,
   "end": 99.72,
   "ja": "レベルは…",
   "ko": "레벨은…",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.032",
   "audio": 0,
   "start": 100.5,
   "end": 101.0,
   "ja": "3ね",
   "ko": "3이야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.033",
   "audio": 0,
   "start": 102.08,
   "end": 103.0,
   "ja": "悪いけど…",
   "ko": "미안하지만…",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.034",
   "audio": 0,
   "start": 103.94,
   "end": 106.22,
   "ja": "手を、どけてくれないかな",
   "ko": "손 좀 치워 줄래?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.034n",
   "audio": 0,
   "start": 108.02,
   "end": 109.14,
   "ja": "早くしてね",
   "ko": "빨리 해 줘.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.035",
   "audio": 0,
   "start": 110.71,
   "end": 112.17,
   "ja": "じゃあ少し我慢してね",
   "ko": "그럼 조금만 참아.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.036",
   "audio": 0,
   "start": 114.0,
   "end": 115.3,
   "ja": "行くよ",
   "ko": "간다.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.037",
   "audio": 0,
   "start": 121.66,
   "end": 125.28,
   "ja": "頑張って。自分が何をするべきなのか考えて",
   "ko": "힘내. 자신이 뭘 해야 하는지 생각해 봐.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.038",
   "audio": 0,
   "start": 128.38,
   "end": 130.0,
   "ja": "本当の君は…",
   "ko": "진짜 너는…",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.038n",
   "audio": 0,
   "start": 133.44,
   "end": 134.82,
   "ja": "もう少しよ",
   "ko": "조금만 더.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.039",
   "audio": 1,
   "start": 0.62,
   "end": 1.4,
   "ja": "終わったよ",
   "ko": "끝났어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.040",
   "audio": 1,
   "start": 3.2,
   "end": 4.99,
   "ja": "楽になったような気がする",
   "ko": "편해진 것 같아.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.041",
   "audio": 1,
   "start": 5.93,
   "end": 6.93,
   "ja": "ねえレイファン",
   "ko": "있잖아, 레이판.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.042",
   "audio": 1,
   "start": 7.63,
   "end": 10.93,
   "ja": "私たちやっぱり野蛮なアウトローかしら",
   "ko": "우리 역시 야만적인 무법자일까?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.043",
   "audio": 1,
   "start": 11.49,
   "end": 15.23,
   "ja": "ううん、きっと違うと思う",
   "ko": "아니, 분명 아닐 거야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.044",
   "audio": 1,
   "start": 16.79,
   "end": 20.03,
   "ja": "レイファン、教えてほしいことがあるんだ",
   "ko": "레이판, 알려 줬으면 하는 게 있어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.045",
   "audio": 1,
   "start": 20.89,
   "end": 22.63,
   "ja": "プロト姉様のことでしょ",
   "ko": "프로토 언니 얘기지?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.046",
   "audio": 1,
   "start": 22.63,
   "end": 26.15,
   "ja": "うん、プロトはここにいるって聞いたんだけど",
   "ko": "응, 프로토가 여기 있다고 들었는데.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.047",
   "audio": 1,
   "start": 26.83,
   "end": 31.09,
   "ja": "お姉さまはいつも私にしか本当の居場所を教えないの",
   "ko": "언니는 늘 나한테만 진짜 있는 곳을 알려 줘.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.048",
   "audio": 1,
   "start": 32.03,
   "end": 34.45,
   "ja": "へー、徹底してるのね",
   "ko": "흐음, 철저하네.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.049",
   "audio": 1,
   "start": 35.21,
   "end": 38.05,
   "ja": "この地上のどこを探しても見つからないわ",
   "ko": "이 땅 어디를 찾아도 없을 거야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.050",
   "audio": 1,
   "start": 39.01,
   "end": 39.37,
   "ja": "じゃあ",
   "ko": "그럼…",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.051",
   "audio": 1,
   "start": 40.29,
   "end": 41.87,
   "ja": "空よりも高いところ",
   "ko": "하늘보다도 높은 곳.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.052",
   "audio": 1,
   "start": 42.45,
   "end": 43.09,
   "ja": "宇宙?",
   "ko": "우주?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.053",
   "audio": 1,
   "start": 44.27,
   "end": 47.25,
   "ja": "そう、お姉さまはここに眠っていた分身を起こして",
   "ko": "응. 언니는 여기 잠들어 있던 분신을 깨워서",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.054",
   "audio": 1,
   "start": 47.25,
   "end": 49.19,
   "ja": "衛星軌道上へ上がったの",
   "ko": "위성 궤도로 올라갔어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.055",
   "audio": 1,
   "start": 51.15,
   "end": 54.52,
   "ja": "お姉さま、ものすごく怯えてた",
   "ko": "언니, 몹시 겁에 질려 있었어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.056",
   "audio": 1,
   "start": 55.38,
   "end": 57.3,
   "ja": "スチームハーツがどうのって",
   "ko": "스팀 하츠가 어쩌고 하면서.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.057",
   "audio": 1,
   "start": 57.86,
   "end": 59.2,
   "ja": "スチームハーツ?",
   "ko": "스팀 하츠?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.057n",
   "audio": 1,
   "start": 60.4,
   "end": 62.0,
   "ja": "それを聞いて思い出したの",
   "ko": "그걸 듣고 생각났어.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.058",
   "audio": 1,
   "start": 62.57,
   "end": 64.69,
   "ja": "ここの守護者に伝わる昔話",
   "ko": "이곳 수호자에게 전해지는 옛이야기야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.059",
   "audio": 1,
   "start": 64.69,
   "end": 69.11,
   "ja": "災い起こる時、導きの光、",
   "ko": "재앙이 일어날 때 인도의 빛,",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.060",
   "audio": 1,
   "start": 69.41,
   "end": 71.19,
   "ja": "スチームハーツ現る",
   "ko": "스팀 하츠 나타나리.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.061",
   "audio": 1,
   "start": 72.13,
   "end": 76.05,
   "ja": "紺碧の星、取り戻す力なりっていうお話",
   "ko": "쪽빛 별을 되찾을 힘이리라… 그런 이야기야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.062",
   "audio": 1,
   "start": 77.27,
   "end": 78.57,
   "ja": "取り戻す?",
   "ko": "되찾는다고?",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.063",
   "audio": 1,
   "start": 78.93,
   "end": 82.1,
   "ja": "この力っていうのが、",
   "ko": "이 힘이라는 게",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.064",
   "audio": 1,
   "start": 82.22,
   "end": 86.56,
   "ja": "あなたたちの自分を信じるという心のことだと思えるの",
   "ko": "자신을 믿는 너희의 마음을 말하는 것 같아.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.065",
   "audio": 1,
   "start": 86.64,
   "end": 87.5,
   "ja": "今なら",
   "ko": "지금이라면.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.066",
   "audio": 1,
   "start": 87.5,
   "end": 89.72,
   "ja": "僕はそんな大したやつじゃないよ",
   "ko": "난 그렇게 대단한 녀석이 아니야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.067",
   "audio": 1,
   "start": 91.42,
   "end": 93.22,
   "ja": "ただ、みんなを助けたいだけ",
   "ko": "그냥 모두를 돕고 싶을 뿐이야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.068",
   "audio": 1,
   "start": 94.08,
   "end": 98.7,
   "ja": "それが僕たちのためにもみんなのためにもなると思っているだけさ",
   "ko": "그게 우리에게도 모두에게도 좋다고 생각할 뿐이야.",
   "status": "distribution_eligible"
  },
  {
   "id": "vis5.069",
   "audio": 1,
   "start": 99.62,
   "end": 103.42,
   "ja": "災いってのがプロトの心変わりだとすると",
   "ko": "재앙이라는 게 프로토의 변심이라면",
   "status": "distribution_eligible"
